+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=data&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "gib", to: "mb", v: 1, result: 1073.741824, display: "1073.74" },
+  { from: "gb", to: "mib", v: 1, result: 953.674316406, display: "953.67" },
+  { from: "mib", to: "mb", v: 5, result: 5.24288, display: "5.24" },
+];
+
+for (const c of cases) {
+  test(`data: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`data: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("data has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/data"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Data"));
+});
