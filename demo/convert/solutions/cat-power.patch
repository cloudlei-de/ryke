+import type { Category } from "../types.ts";
+
+export const power: Category = {
+  id: "power",
+  name: "Power",
+  base: "W",
+  units: [
+    { id: "w", name: "Watt", symbol: "W", toBase: (v) => v, fromBase: (v) => v },
+    { id: "kw", name: "Kilowatt", symbol: "kW", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "mw", name: "Megawatt", symbol: "MW", toBase: (v) => v * 1e6, fromBase: (v) => v / 1e6 },
+    { id: "hp", name: "Horsepower (mechanical)", symbol: "hp", toBase: (v) => v * 745.69987158227, fromBase: (v) => v / 745.69987158227 },
+    { id: "ps", name: "Metric horsepower", symbol: "PS", toBase: (v) => v * 735.49875, fromBase: (v) => v / 735.49875 },
+    { id: "btuh", name: "BTU per hour", symbol: "BTU/h", toBase: (v) => v * 0.29307107017222, fromBase: (v) => v / 0.29307107017222 },
+    { id: "kcalh", name: "Kilocalorie per hour", symbol: "kcal/h", toBase: (v) => (v * 4184) / 3600, fromBase: (v) => (v * 3600) / 4184 },
+  ],
+};
