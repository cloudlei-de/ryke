@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=power&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "hp", to: "kw", v: 1, result: 0.745699871582, display: "0.75" },
+  { from: "w", to: "btuh", v: 100, result: 341.214163313, display: "341.21" },
+  { from: "ps", to: "w", v: 1, result: 735.49875, display: "735.50" },
+];
+
+for (const c of cases) {
+  test(`power: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`power: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("power has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/power"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Power"));
+});
