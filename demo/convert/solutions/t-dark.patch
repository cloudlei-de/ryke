--- /dev/null
+++ b/test/dark.test.ts
@@ -0,0 +1,18 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+import { styles } from "../src/ui/styles.ts";
+
+test("styles define a dark theme for the system setting and for the toggle", () => {
+  assert.ok(styles.includes("prefers-color-scheme: dark"));
+  assert.ok(styles.includes('[data-theme="dark"]'));
+});
+
+for (const path of ["/", "/c/mass"]) {
+  test(`${path} has the theme toggle in the footer`, async () => {
+    const page = await (await worker.fetch(new Request(`http://localhost${path}`))).text();
+    const footer = page.slice(page.indexOf("<footer"), page.indexOf("</footer>"));
+    assert.ok(footer.includes("data-theme-toggle"));
+    assert.ok(footer.includes("convert:theme"));
+  });
+}
