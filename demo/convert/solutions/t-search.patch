index 0000000..9bf5613
--- /dev/null
+++ b/test/search.test.ts
@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import vm from "node:vm";
+import worker from "../src/index.ts";
+
+async function html(path: string): Promise<string> {
+  return (await worker.fetch(new Request(`http://localhost${path}`))).text();
+}
+
+function header(page: string): string {
+  return page.slice(page.indexOf("<header"), page.indexOf("</header>"));
+}
+
+type Tile = { name: string; hidden: boolean; textContent: string; querySelector(selector: string): { textContent: string } | null };
+
+// There is no DOM in the demo, so the script the page ships runs against the few members it uses. A tile's
+// textContent holds the unit count line as well as the name, like the real markup does.
+function openPage(page: string, names: string[]) {
+  const script = /<script>([\s\S]*?)<\/script>/.exec(header(page))?.[1];
+  assert.ok(script, "the header carries the filter script");
+  let onInput: (() => void) | undefined;
+  const input = {
+    value: "",
+    addEventListener(type: string, listener: () => void) {
+      if (type === "input") onInput = listener;
+    },
+  };
+  const tiles: Tile[] = names.map((name) => ({
+    name,
+    hidden: false,
+    textContent: `\n  ${name}\n  3 units\n`,
+    querySelector: (selector) => (selector === "strong" ? { textContent: name } : null),
+  }));
+  const document = {
+    getElementById: (id: string) => (id === "search" ? input : null),
+    querySelectorAll: (selector: string) => (selector === ".tile" ? tiles : []),
+  };
+  vm.runInNewContext(script, { document });
+  return {
+    type(text: string) {
+      assert.ok(onInput, "the script listens for input events on the search box");
+      input.value = text;
+      onInput();
+    },
+    visible: () => tiles.filter((t) => !t.hidden).map((t) => t.name),
+  };
+}
+
+const names = ["Length", "Mass", "Temperature"];
+const home = await html("/");
+
+test("every page has a search input in the header: home, converter and not-found pages", async () => {
+  for (const path of ["/", "/c/length", "/nope"]) {
+    const head = header(await html(path));
+    assert.ok(head.includes('id="search"'), `${path}: no search input`);
+    assert.ok(head.includes('type="search"'), `${path}: the input is not a search field`);
+    assert.ok(head.includes("<script>"), `${path}: no filter script`);
+  }
+});
+
+test("typing on the home page hides the tiles whose name does not contain the text", () => {
+  const tileNames = [...home.matchAll(/<div class="tile"[\s\S]*?<strong>(.*?)<\/strong>/g)].map((m) => m[1]!);
+  assert.ok(tileNames.includes("Mass") && tileNames.includes("Length"), "the home page has its tiles");
+  const page = openPage(home, tileNames);
+  page.type("mass");
+  const left = page.visible();
+  assert.ok(left.includes("Mass"));
+  assert.ok(!left.includes("Length") && !left.includes("Temperature"));
+  for (const name of tileNames) assert.equal(left.includes(name), name.toLowerCase().includes("mass"), name);
+});
+
+test("typing keeps the tiles that match and hides the rest", () => {
+  const page = openPage(home, names);
+  for (const [typed, expected] of [
+    ["mass", ["Mass"]],
+    ["temp", ["Temperature"]],
+    ["e", ["Length", "Temperature"]],
+    ["Length", ["Length"]],
+  ] as const) {
+    page.type(typed);
+    assert.deepEqual(page.visible(), expected, typed);
+  }
+});
+
+test("text that matches no category name hides every tile", () => {
+  const page = openPage(home, names);
+  page.type("zzz");
+  assert.deepEqual(page.visible(), []);
+});
+
+test("clearing the search box shows every tile again, also when it holds only spaces", () => {
+  const page = openPage(home, names);
+  for (const cleared of ["", "   "]) {
+    page.type("mass");
+    assert.deepEqual(page.visible(), ["Mass"]);
+    page.type(cleared);
+    assert.deepEqual(page.visible(), names, JSON.stringify(cleared));
+  }
+});
+
+test("tiles hidden by one text are shown again when the text changes to match them", () => {
+  const page = openPage(home, names);
+  page.type("ma");
+  assert.deepEqual(page.visible(), ["Mass"]);
+  page.type("m");
+  assert.deepEqual(page.visible(), ["Mass", "Temperature"]);
+  page.type("l");
+  assert.deepEqual(page.visible(), ["Length"]);
+});
+
+test("the filter ignores letter case and the spaces around the text", () => {
+  const page = openPage(home, names);
+  for (const typed of ["MASS", "  mass ", "mAsS"]) {
+    page.type(typed);
+    assert.deepEqual(page.visible(), ["Mass"], JSON.stringify(typed));
+  }
+});
+
+test("the filter matches the category name, not the unit count line of the tile", () => {
+  const page = openPage(home, names);
+  for (const typed of ["units", "3", "3 units"]) {
+    page.type(typed);
+    assert.deepEqual(page.visible(), [], typed);
+  }
+});
+
+test("typing on a page without tiles does nothing and does not throw", async () => {
+  const page = openPage(await html("/c/length"), []);
+  page.type("mass");
+  assert.deepEqual(page.visible(), []);
+});
