+++ b/test/search.test.ts
@@ -0,0 +1,22 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+async function html(path: string): Promise<string> {
+  return (await worker.fetch(new Request(`http://localhost${path}`))).text();
+}
+
+for (const path of ["/", "/c/length", "/nope"]) {
+  test(`${path} has the search box in the header`, async () => {
+    const page = await html(path);
+    const header = page.slice(page.indexOf("<header"), page.indexOf("</header>"));
+    assert.ok(header.includes('id="search"'));
+    assert.ok(header.includes('type="search"'));
+  });
+}
+
+test("the filter script targets the search box and the tiles", async () => {
+  const page = await html("/");
+  assert.ok(page.includes('document.getElementById("search")'));
+  assert.ok(page.includes('querySelectorAll(".tile")'));
+});
