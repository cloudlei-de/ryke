@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=volume&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "gal", to: "ml", v: 1, result: 3785.411784, display: "3785.41" },
+  { from: "m3", to: "l", v: 1, result: 1000, display: "1000.00" },
+  { from: "igal", to: "gal", v: 1, result: 1.2009499255, display: "1.20" },
+];
+
+for (const c of cases) {
+  test(`volume: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`volume: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("volume has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/volume"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Volume"));
+});
