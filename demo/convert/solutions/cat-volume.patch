+import type { Category } from "../types.ts";
+
+export const volume: Category = {
+  id: "volume",
+  name: "Volume",
+  base: "L",
+  units: [
+    { id: "l", name: "Litre", symbol: "L", toBase: (v) => v, fromBase: (v) => v },
+    { id: "ml", name: "Millilitre", symbol: "mL", toBase: (v) => v * 0.001, fromBase: (v) => v / 0.001 },
+    { id: "m3", name: "Cubic metre", symbol: "m³", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "cm3", name: "Cubic centimetre", symbol: "cm³", toBase: (v) => v * 0.001, fromBase: (v) => v / 0.001 },
+    { id: "gal", name: "US gallon", symbol: "gal", toBase: (v) => v * 3.785411784, fromBase: (v) => v / 3.785411784 },
+    { id: "qt", name: "US quart", symbol: "qt", toBase: (v) => v * 0.946352946, fromBase: (v) => v / 0.946352946 },
+    { id: "pt", name: "US pint", symbol: "pt", toBase: (v) => v * 0.473176473, fromBase: (v) => v / 0.473176473 },
+    { id: "floz", name: "US fluid ounce", symbol: "fl oz", toBase: (v) => v * 0.0295735295625, fromBase: (v) => v / 0.0295735295625 },
+    { id: "ft3", name: "Cubic foot", symbol: "ft³", toBase: (v) => v * 28.316846592, fromBase: (v) => v / 28.316846592 },
+    { id: "igal", name: "Imperial gallon", symbol: "imp gal", toBase: (v) => v * 4.54609, fromBase: (v) => v / 4.54609 },
+  ],
