+import type { Category } from "../types.ts";
+
+// Static demo rates (units per US dollar), not live quotes.
+export const currency: Category = {
+  id: "currency",
+  name: "Currency",
+  base: "USD",
+  units: [
+    { id: "usd", name: "US dollar", symbol: "USD", toBase: (v) => v, fromBase: (v) => v },
+    { id: "eur", name: "Euro", symbol: "EUR", toBase: (v) => v / 0.92, fromBase: (v) => v * 0.92 },
+    { id: "gbp", name: "British pound", symbol: "GBP", toBase: (v) => v / 0.79, fromBase: (v) => v * 0.79 },
+    { id: "jpy", name: "Japanese yen", symbol: "JPY", toBase: (v) => v / 150, fromBase: (v) => v * 150 },
+    { id: "chf", name: "Swiss franc", symbol: "CHF", toBase: (v) => v / 0.88, fromBase: (v) => v * 0.88 },
+    { id: "cad", name: "Canadian dollar", symbol: "CAD", toBase: (v) => v / 1.36, fromBase: (v) => v * 1.36 },
+    { id: "aud", name: "Australian dollar", symbol: "AUD", toBase: (v) => v / 1.52, fromBase: (v) => v * 1.52 },
+    { id: "inr", name: "Indian rupee", symbol: "INR", toBase: (v) => v / 83, fromBase: (v) => v * 83 },
+  ],
+};
