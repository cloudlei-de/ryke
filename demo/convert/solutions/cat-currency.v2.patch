+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=currency&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "usd", to: "eur", v: 100, result: 92, display: "92" },
+  { from: "gbp", to: "chf", v: 1, result: 1.11392405063, display: "1.114" },
+  { from: "chf", to: "eur", v: 50, result: 52.2727272727, display: "52.273" },
+];
+
+for (const c of cases) {
+  test(`currency: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`currency: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("currency has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/currency"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Currency"));
+});
