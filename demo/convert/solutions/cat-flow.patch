+import type { Category } from "../types.ts";
+
+export const flow: Category = {
+  id: "flow",
+  name: "Flow",
+  base: "m³/s",
+  units: [
+    { id: "m3s", name: "Cubic metre per second", symbol: "m³/s", toBase: (v) => v, fromBase: (v) => v },
+    { id: "ls", name: "Litre per second", symbol: "L/s", toBase: (v) => v * 0.001, fromBase: (v) => v / 0.001 },
+    { id: "lmin", name: "Litre per minute", symbol: "L/min", toBase: (v) => v / 60000, fromBase: (v) => v * 60000 },
+    { id: "m3h", name: "Cubic metre per hour", symbol: "m³/h", toBase: (v) => v / 3600, fromBase: (v) => v * 3600 },
+    { id: "galmin", name: "US gallon per minute", symbol: "gal/min", toBase: (v) => v * 0.0000630901964, fromBase: (v) => v / 0.0000630901964 },
+    { id: "cfm", name: "Cubic foot per minute", symbol: "ft³/min", toBase: (v) => v * 0.0004719474432, fromBase: (v) => v / 0.0004719474432 },
+  ],
+};
