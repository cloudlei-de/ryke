@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=flow&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "lmin", to: "ls", v: 60, result: 1, display: "1.00" },
+  { from: "cfm", to: "lmin", v: 1, result: 28.316846592, display: "28.32" },
+  { from: "galmin", to: "lmin", v: 10, result: 37.85411784, display: "37.85" },
+];
+
+for (const c of cases) {
+  test(`flow: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`flow: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("flow has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/flow"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Flow"));
+});
