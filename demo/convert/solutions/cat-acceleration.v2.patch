+import type { Category } from "../types.ts";
+
+export const acceleration: Category = {
+  id: "acceleration",
+  name: "Acceleration",
+  base: "m/s²",
+  units: [
+    { id: "mps2", name: "Metre per second squared", symbol: "m/s²", toBase: (v) => v, fromBase: (v) => v },
+    { id: "g", name: "Standard gravity", symbol: "g", toBase: (v) => v * 9.80665, fromBase: (v) => v / 9.80665 },
+    { id: "gal", name: "Gal", symbol: "Gal", toBase: (v) => v * 0.01, fromBase: (v) => v / 0.01 },
+    { id: "fps2", name: "Foot per second squared", symbol: "ft/s²", toBase: (v) => v * 0.3048, fromBase: (v) => v / 0.3048 },
+    { id: "kmhs", name: "Kilometre per hour per second", symbol: "km/h/s", toBase: (v) => v / 3.6, fromBase: (v) => v * 3.6 },
+    { id: "mphs", name: "Mile per hour per second", symbol: "mph/s", toBase: (v) => v * 0.44704, fromBase: (v) => v / 0.44704 },
+  ],
+};
diff --git a/test/acceleration.test.ts b/test/acceleration.test.ts
