--- /dev/null
+++ b/test/acceleration.test.ts
@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=acceleration&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "g", to: "mps2", v: 1, result: 9.80665, display: "9.807" },
+  { from: "g", to: "fps2", v: 1, result: 32.1740485564, display: "32.174" },
+  { from: "mphs", to: "mps2", v: 60, result: 26.8224, display: "26.822" },
+];
+
+for (const c of cases) {
+  test(`acceleration: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`acceleration: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("acceleration has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/acceleration"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Acceleration"));
+});
