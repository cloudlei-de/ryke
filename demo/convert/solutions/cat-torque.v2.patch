+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=torque&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "lbfft", to: "nm", v: 1, result: 1.35581794833, display: "1.356" },
+  { from: "nm", to: "lbfft", v: 100, result: 73.7562149277, display: "73.756" },
+  { from: "lbfin", to: "lbfft", v: 12, result: 1, display: "1" },
+];
+
+for (const c of cases) {
+  test(`torque: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`torque: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("torque has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/torque"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Torque"));
+});
