+import type { Category } from "../types.ts";
+
+export const torque: Category = {
+  id: "torque",
+  name: "Torque",
+  base: "N·m",
+  units: [
+    { id: "nm", name: "Newton-metre", symbol: "N·m", toBase: (v) => v, fromBase: (v) => v },
+    { id: "knm", name: "Kilonewton-metre", symbol: "kN·m", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "kgfm", name: "Kilogram-force metre", symbol: "kgf·m", toBase: (v) => v * 9.80665, fromBase: (v) => v / 9.80665 },
+    { id: "lbfft", name: "Pound-force foot", symbol: "lbf·ft", toBase: (v) => v * 1.3558179483314, fromBase: (v) => v / 1.3558179483314 },
+    { id: "lbfin", name: "Pound-force inch", symbol: "lbf·in", toBase: (v) => v * 0.112984829028, fromBase: (v) => v / 0.112984829028 },
+    { id: "ozfin", name: "Ounce-force inch", symbol: "ozf·in", toBase: (v) => v * 0.00706155181423, fromBase: (v) => v / 0.00706155181423 },
+    { id: "dyncm", name: "Dyne-centimetre", symbol: "dyn·cm", toBase: (v) => v * 1e-7, fromBase: (v) => v / 1e-7 },
+  ],
+};
