+import type { Category } from "../types.ts";
+
+export const cooking: Category = {
+  id: "cooking",
+  name: "Cooking",
+  base: "mL",
+  units: [
+    { id: "ml", name: "Millilitre", symbol: "mL", toBase: (v) => v, fromBase: (v) => v },
+    { id: "tsp", name: "Teaspoon (US)", symbol: "tsp", toBase: (v) => v * 4.92892159375, fromBase: (v) => v / 4.92892159375 },
+    { id: "tbsp", name: "Tablespoon (US)", symbol: "tbsp", toBase: (v) => v * 14.78676478125, fromBase: (v) => v / 14.78676478125 },
+    { id: "floz", name: "Fluid ounce (US)", symbol: "fl oz", toBase: (v) => v * 29.5735295625, fromBase: (v) => v / 29.5735295625 },
+    { id: "cup", name: "Cup (US)", symbol: "cup", toBase: (v) => v * 236.5882365, fromBase: (v) => v / 236.5882365 },
+    { id: "pint", name: "Pint (US)", symbol: "pt", toBase: (v) => v * 473.176473, fromBase: (v) => v / 473.176473 },
+  ],
+};
