@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=cooking&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "tsp", to: "tbsp", v: 3, result: 1, display: "1" },
+  { from: "cup", to: "ml", v: 1, result: 236.5882365, display: "236.588" },
+  { from: "ml", to: "cup", v: 250, result: 1.05668820943, display: "1.057" },
+];
+
+for (const c of cases) {
+  test(`cooking: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`cooking: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("cooking has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/cooking"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Cooking"));
+});
