diff --git a/test/kelvin-first.test.ts b/test/kelvin-first.test.ts
new file mode 100644
index 0000000..8c2f2db
--- /dev/null
+++ b/test/kelvin-first.test.ts
@@ -0,0 +1,18 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+import { temperature } from "../src/units/temperature.ts";
+
+test("Kelvin is listed first, then Celsius and Fahrenheit", () => {
+  assert.deepEqual(
+    temperature.units.map((u) => u.id),
+    ["k", "c", "f"],
+  );
+});
+
+test("the temperature page converts from Kelvin first", async () => {
+  const page = await (await worker.fetch(new Request("http://localhost/c/temperature"))).text();
+  assert.ok(page.includes("<h2>1 Kelvin equals</h2>"));
+  // Only the Celsius row is checked: the Fahrenheit row depends on how Fahrenheit is rounded.
+  assert.ok(page.includes("-272.15 °C"));
+});
