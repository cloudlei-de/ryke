+import type { Category } from "../types.ts";
+
+// Dynamic viscosity. Water is about 1 cP.
+export const viscosity: Category = {
+  id: "viscosity",
+  name: "Viscosity",
+  base: "Pa·s",
+  units: [
+    { id: "pas", name: "Pascal-second", symbol: "Pa·s", toBase: (v) => v, fromBase: (v) => v },
+    { id: "poise", name: "Poise", symbol: "P", toBase: (v) => v * 0.1, fromBase: (v) => v / 0.1 },
+    { id: "cp", name: "Centipoise", symbol: "cP", toBase: (v) => v * 0.001, fromBase: (v) => v / 0.001 },
+    { id: "lbfts", name: "Pound per foot-second", symbol: "lb/(ft·s)", toBase: (v) => v * 1.48816394357, fromBase: (v) => v / 1.48816394357 },
+    { id: "lbfsft2", name: "Pound-force second per square foot", symbol: "lbf·s/ft²", toBase: (v) => v * 47.8802589803, fromBase: (v) => v / 47.8802589803 },
+  ],
+};
