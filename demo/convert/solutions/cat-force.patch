@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=force&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "lbf", to: "n", v: 1, result: 4.44822161526, display: "4.45" },
+  { from: "kgf", to: "n", v: 1, result: 9.80665, display: "9.81" },
+  { from: "kn", to: "lbf", v: 2, result: 449.617886199, display: "449.62" },
+];
+
+for (const c of cases) {
+  test(`force: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`force: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("force has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/force"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Force"));
+});
