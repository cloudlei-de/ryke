+import type { Category } from "../types.ts";
+
+export const force: Category = {
+  id: "force",
+  name: "Force",
+  base: "N",
+  units: [
+    { id: "n", name: "Newton", symbol: "N", toBase: (v) => v, fromBase: (v) => v },
+    { id: "kn", name: "Kilonewton", symbol: "kN", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "lbf", name: "Pound-force", symbol: "lbf", toBase: (v) => v * 4.4482216152605, fromBase: (v) => v / 4.4482216152605 },
+    { id: "kgf", name: "Kilogram-force", symbol: "kgf", toBase: (v) => v * 9.80665, fromBase: (v) => v / 9.80665 },
+    { id: "dyn", name: "Dyne", symbol: "dyn", toBase: (v) => v * 1e-5, fromBase: (v) => v / 1e-5 },
+    { id: "pdl", name: "Poundal", symbol: "pdl", toBase: (v) => v * 0.138254954376, fromBase: (v) => v / 0.138254954376 },
+  ],
+};
