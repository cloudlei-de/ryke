diff --git a/test/imperial-length.test.ts b/test/imperial-length.test.ts
new file mode 100644
index 0000000..89d4232
--- /dev/null
+++ b/test/imperial-length.test.ts
@@ -0,0 +1,15 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+test("a mile is about 1.609 km", async () => {
+  const res = await worker.fetch(new Request("http://localhost/api/convert?c=length&from=mi&to=km&v=1"));
+  const body = (await res.json()) as { result: number };
+  assert.ok(Math.abs(body.result - 1.609) < 0.001, `got ${body.result}`);
+});
+
+test("a yard is 0.9144 m", async () => {
+  const res = await worker.fetch(new Request("http://localhost/api/convert?c=length&from=yd&to=m&v=1"));
+  const body = (await res.json()) as { result: number };
+  assert.ok(Math.abs(body.result - 0.9144) < 1e-9, `got ${body.result}`);
+});
