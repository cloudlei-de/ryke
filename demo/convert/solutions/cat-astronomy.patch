@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=astronomy&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "pc", to: "ly", v: 1, result: 3.26156377717, display: "3.26" },
+  { from: "ly", to: "au", v: 1, result: 63241.0770843, display: "63241.08" },
+  { from: "au", to: "ld", v: 1, result: 389.173412782, display: "389.17" },
+];
+
+for (const c of cases) {
+  test(`astronomy: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`astronomy: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("astronomy has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/astronomy"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Astronomy"));
+});
