+import type { Category } from "../types.ts";
+
+export const astronomy: Category = {
+  id: "astronomy",
+  name: "Astronomy",
+  base: "km",
+  units: [
+    { id: "ly", name: "Light-year", symbol: "ly", toBase: (v) => v * 9460730472580.8, fromBase: (v) => v / 9460730472580.8 },
+    { id: "pc", name: "Parsec", symbol: "pc", toBase: (v) => v * 30856775814913.67, fromBase: (v) => v / 30856775814913.67 },
+    { id: "au", name: "Astronomical unit", symbol: "au", toBase: (v) => v * 149597870.7, fromBase: (v) => v / 149597870.7 },
+    { id: "ld", name: "Lunar distance", symbol: "LD", toBase: (v) => v * 384399, fromBase: (v) => v / 384399 },
+    { id: "rsun", name: "Solar radius", symbol: "R☉", toBase: (v) => v * 695700, fromBase: (v) => v / 695700 },
+    { id: "rearth", name: "Earth radius", symbol: "R⊕", toBase: (v) => v * 6371, fromBase: (v) => v / 6371 },
+    { id: "km", name: "Kilometre", symbol: "km", toBase: (v) => v, fromBase: (v) => v },
+  ],
+};
