@@ -0,0 +1,28 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { formatValue } from "../src/format.ts";
+
+// Every call passes its digit count, so the table holds whatever the default digit count is.
+const cases: [number, number, string][] = [
+  [1234.5, 2, "1234.5"],
+  [1000, 2, "1000"],
+  [2.5, 3, "2.5"],
+  [1 / 3, 3, "0.333"],
+  [12.3456, 2, "12.35"],
+  [7, 3, "7"],
+  [-1234.567, 1, "-1234.6"],
+];
+
+for (const [n, digits, expected] of cases) {
+  test(`formatValue(${n}, ${digits}) is ${expected}`, () => {
+    assert.equal(formatValue(n, digits), expected);
+  });
+}
+
+test("thousands are never grouped", () => {
+  assert.ok(!formatValue(1234567.891, 2).includes(","));
+});
+
+test("non-finite values are a dash", () => {
+  for (const n of [NaN, Infinity, -Infinity]) assert.equal(formatValue(n, 2), "—");
+});
