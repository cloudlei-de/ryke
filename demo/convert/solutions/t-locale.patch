 // change to the rounding rule is read by nearly every other change in flight.
 export function formatValue(n: number, digits = 2): string {
   if (!Number.isFinite(n)) return "—";
-  return n.toFixed(digits);
+  // Intl instead of toFixed so the rounding rule lives in one locale-aware place. en-US without grouping
+  // keeps "." as the decimal mark and "1000" as a single token for API consumers.
+  return new Intl.NumberFormat("en-US", { minimumFractionDigits: 0, maximumFractionDigits: digits, useGrouping: false }).format(n);
 }
