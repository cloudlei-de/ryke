@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=velocity&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+const cases = [
+  { from: "kmh", to: "ms", v: 100, result: 27.7777777778 },
+  { from: "kn", to: "kmh", v: 1, result: 1.852 },
+  { from: "mph", to: "kmh", v: 60, result: 96.56064 },
+];
+
+for (const c of cases) {
+  test(`velocity: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+}
+
+test("velocity has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/velocity"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Velocity"));
+});
