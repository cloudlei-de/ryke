+import type { Category } from "../types.ts";
+
+export const velocity: Category = {
+  id: "velocity",
+  name: "Velocity",
+  base: "m/s",
+  units: [
+    { id: "ms", name: "Metre per second", symbol: "m/s", toBase: (v) => v, fromBase: (v) => v },
+    { id: "kmh", name: "Kilometre per hour", symbol: "km/h", toBase: (v) => v / 3.6, fromBase: (v) => v * 3.6 },
+    { id: "mph", name: "Mile per hour", symbol: "mph", toBase: (v) => v * 0.44704, fromBase: (v) => v / 0.44704 },
+    { id: "kn", name: "Knot", symbol: "kn", toBase: (v) => (v * 1852) / 3600, fromBase: (v) => (v * 3600) / 1852 },
+  ],
+};
