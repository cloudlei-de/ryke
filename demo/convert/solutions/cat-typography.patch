@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=typography&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "in", to: "px", v: 1, result: 96, display: "96.00" },
+  { from: "pt", to: "mm", v: 12, result: 4.23333333333, display: "4.23" },
+  { from: "mm", to: "px", v: 5, result: 18.8976377953, display: "18.90" },
+];
+
+for (const c of cases) {
+  test(`typography: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`typography: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("typography has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/typography"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Typography"));
+});
