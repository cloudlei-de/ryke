+import type { Category } from "../types.ts";
+
+export const typography: Category = {
+  id: "typography",
+  name: "Typography",
+  base: "pt",
+  units: [
+    { id: "pt", name: "Point", symbol: "pt", toBase: (v) => v, fromBase: (v) => v },
+    { id: "pc", name: "Pica", symbol: "pc", toBase: (v) => v * 12, fromBase: (v) => v / 12 },
+    { id: "px", name: "Pixel (CSS, 96 dpi)", symbol: "px", toBase: (v) => v * 0.75, fromBase: (v) => v / 0.75 },
+    { id: "in", name: "Inch", symbol: "in", toBase: (v) => v * 72, fromBase: (v) => v / 72 },
+    { id: "mm", name: "Millimetre", symbol: "mm", toBase: (v) => (v * 72) / 25.4, fromBase: (v) => (v * 25.4) / 72 },
+    { id: "cm", name: "Centimetre", symbol: "cm", toBase: (v) => (v * 720) / 25.4, fromBase: (v) => (v * 25.4) / 720 },
+  ],
+};
