+// Favourites live in localStorage so the server stays stateless; the script restores them after load.
+export function favoriteButton(id: string): string {
+  return `<button class="fav" type="button" data-fav="${id}" aria-pressed="false" aria-label="Favourite ${id}">☆</button>`;
+}
+
+export const favoritesScript = `<style>
+.fav { position: absolute; top: 8px; right: 8px; padding: 2px 8px; border: 0; background: transparent; font-size: 18px; color: var(--muted); }
+.fav[aria-pressed="true"] { color: var(--accent); }
+</style>
+<script>
+(function () {
+  var KEY = "convert:favorites";
+  var saved = [];
+  try { saved = JSON.parse(localStorage.getItem(KEY) || "[]"); } catch (e) {}
+  var tiles = document.querySelector(".tiles");
+  function sync() {
+    document.querySelectorAll(".fav").forEach(function (btn) {
+      var on = saved.indexOf(btn.dataset.fav) !== -1;
+      btn.setAttribute("aria-pressed", String(on));
+      btn.textContent = on ? "★" : "☆";
+      if (on) tiles.prepend(btn.closest(".tile"));
+    });
+  }
+  document.querySelectorAll(".fav").forEach(function (btn) {
+    btn.addEventListener("click", function () {
+      var i = saved.indexOf(btn.dataset.fav);
+      if (i === -1) saved.push(btn.dataset.fav); else saved.splice(i, 1);
+      try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {}
+      sync();
+    });
+  });
+  sync();
+})();
+</script>`;
diff --git a/test/favorites.test.ts b/test/favorites.test.ts
