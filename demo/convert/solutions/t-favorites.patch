+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+import * as registry from "../src/registry.ts";
+import { favoriteButton, favoritesScript } from "../src/ui/favorites.ts";
+
+test("favoriteButton renders an unpressed star for the category id", () => {
+  const button = favoriteButton("length");
+  assert.ok(button.includes('data-fav="length"'));
+  assert.ok(button.includes('aria-pressed="false"'));
+});
+
+test("the home page has one star per category and the restoring script", async () => {
+  const page = await (await worker.fetch(new Request("http://localhost/"))).text();
+  assert.equal(page.split('class="fav"').length - 1, Object.values(registry).length);
+  assert.ok(page.includes(favoritesScript));
+});
+
+test("converter pages have no stars", async () => {
+  const page = await (await worker.fetch(new Request("http://localhost/c/length"))).text();
+  assert.ok(!page.includes('class="fav"'));
+});
