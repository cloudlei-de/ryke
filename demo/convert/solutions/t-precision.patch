+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { formatValue } from "../src/format.ts";
+import worker from "../src/index.ts";
+
+// Default digits are 3 and trailing zeros are trimmed, so these hold whether the body is toFixed or Intl.
+const defaults: [number, string][] = [
+  [1000, "1000"],
+  [2.5, "2.5"],
+  [0.305, "0.305"],
+  [1 / 3, "0.333"],
+  [12.3456, "12.346"],
+  [10, "10"],
+  [0, "0"],
+  [-0.5, "-0.5"],
+];
+
+for (const [n, expected] of defaults) {
+  test(`formatValue(${n}) is ${expected} by default`, () => {
+    assert.equal(formatValue(n), expected);
+  });
+}
+
+test("an explicit digit count still applies and still trims", () => {
+  assert.equal(formatValue(2.5, 1), "2.5");
+  assert.equal(formatValue(2, 4), "2");
+  assert.equal(formatValue(1.23456, 2), "1.23");
+});
+
+test("non-finite values are a dash", () => {
+  assert.equal(formatValue(NaN), "—");
+});
+
+test("/api/convert displays trimmed values", async () => {
+  const res = await worker.fetch(new Request("http://localhost/api/convert?c=length&from=km&to=m&v=1"));
+  const body = (await res.json()) as { display: string };
+  assert.equal(body.display, "1000");
+});
