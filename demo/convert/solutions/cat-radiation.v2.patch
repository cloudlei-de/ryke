+import type { Category } from "../types.ts";
+
+// Equivalent dose. The banana is a popular joke unit: one banana is about 0.1 µSv.
+export const radiation: Category = {
+  id: "radiation",
+  name: "Radiation",
+  base: "Sv",
+  units: [
+    { id: "sv", name: "Sievert", symbol: "Sv", toBase: (v) => v, fromBase: (v) => v },
+    { id: "msv", name: "Millisievert", symbol: "mSv", toBase: (v) => v * 0.001, fromBase: (v) => v / 0.001 },
+    { id: "usv", name: "Microsievert", symbol: "µSv", toBase: (v) => v * 1e-6, fromBase: (v) => v / 1e-6 },
+    { id: "rem", name: "Rem", symbol: "rem", toBase: (v) => v * 0.01, fromBase: (v) => v / 0.01 },
+    { id: "mrem", name: "Millirem", symbol: "mrem", toBase: (v) => v * 1e-5, fromBase: (v) => v / 1e-5 },
+    { id: "bed", name: "Banana equivalent dose", symbol: "BED", toBase: (v) => v * 1e-7, fromBase: (v) => v / 1e-7 },
+  ],
+};
diff --git a/test/radiation.test.ts b/test/radiation.test.ts
