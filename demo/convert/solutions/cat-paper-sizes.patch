+import type { Category } from "../types.ts";
+
+// Sheet area, so converting A3 to A4 answers how many A4 sheets fit on one A3 sheet.
+export const paperSizes: Category = {
+  id: "paper-sizes",
+  name: "Paper sizes",
+  base: "m²",
+  units: [
+    { id: "a0", name: "A0", symbol: "A0", toBase: (v) => v, fromBase: (v) => v },
+    { id: "a1", name: "A1", symbol: "A1", toBase: (v) => v * 0.5, fromBase: (v) => v / 0.5 },
+    { id: "a2", name: "A2", symbol: "A2", toBase: (v) => v * 0.25, fromBase: (v) => v / 0.25 },
+    { id: "a3", name: "A3", symbol: "A3", toBase: (v) => v * 0.125, fromBase: (v) => v / 0.125 },
+    { id: "a4", name: "A4", symbol: "A4", toBase: (v) => v * 0.0625, fromBase: (v) => v / 0.0625 },
+    { id: "a5", name: "A5", symbol: "A5", toBase: (v) => v * 0.03125, fromBase: (v) => v / 0.03125 },
+    { id: "a6", name: "A6", symbol: "A6", toBase: (v) => v * 0.015625, fromBase: (v) => v / 0.015625 },
+    { id: "letter", name: "US Letter", symbol: "Letter", toBase: (v) => v * 0.06032246, fromBase: (v) => v / 0.06032246 },
+    { id: "legal", name: "US Legal", symbol: "Legal", toBase: (v) => v * 0.07677404, fromBase: (v) => v / 0.07677404 },
+  ],
+};
