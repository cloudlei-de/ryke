@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=paper-sizes&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "a3", to: "a4", v: 1, result: 2, display: "2.00" },
+  { from: "letter", to: "a5", v: 1, result: 1.93031872, display: "1.93" },
+  { from: "legal", to: "letter", v: 1, result: 1.27272727273, display: "1.27" },
+];
+
+for (const c of cases) {
+  test(`paper-sizes: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`paper-sizes: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("paper-sizes has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/paper-sizes"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Paper sizes"));
+});
