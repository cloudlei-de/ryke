+import type { Category } from "../types.ts";
+
+export const pressure: Category = {
+  id: "pressure",
+  name: "Pressure",
+  base: "Pa",
+  units: [
+    { id: "pa", name: "Pascal", symbol: "Pa", toBase: (v) => v, fromBase: (v) => v },
+    { id: "kpa", name: "Kilopascal", symbol: "kPa", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "bar", name: "Bar", symbol: "bar", toBase: (v) => v * 1e5, fromBase: (v) => v / 1e5 },
+    { id: "atm", name: "Standard atmosphere", symbol: "atm", toBase: (v) => v * 101325, fromBase: (v) => v / 101325 },
+    { id: "psi", name: "Pound per square inch", symbol: "psi", toBase: (v) => v * 6894.757293168, fromBase: (v) => v / 6894.757293168 },
+    { id: "mmhg", name: "Millimetre of mercury", symbol: "mmHg", toBase: (v) => v * 133.322387415, fromBase: (v) => v / 133.322387415 },
+    { id: "torr", name: "Torr", symbol: "Torr", toBase: (v) => (v * 101325) / 760, fromBase: (v) => (v * 760) / 101325 },
+  ],
+};
