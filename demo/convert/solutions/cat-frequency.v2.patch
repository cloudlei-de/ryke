@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=frequency&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "ghz", to: "mhz", v: 2.4, result: 2400, display: "2400" },
+  { from: "rpm", to: "hz", v: 3000, result: 50, display: "50" },
+  { from: "rads", to: "hz", v: 1, result: 0.159154943092, display: "0.159" },
+];
+
+for (const c of cases) {
+  test(`frequency: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`frequency: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("frequency has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/frequency"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Frequency"));
+});
