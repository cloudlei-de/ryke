@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=angle&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "turn", to: "rad", v: 1, result: 6.28318530718, display: "6.28" },
+  { from: "deg", to: "rad", v: 180, result: 3.14159265359, display: "3.14" },
+  { from: "rad", to: "deg", v: 1, result: 57.2957795131, display: "57.30" },
+];
+
+for (const c of cases) {
+  test(`angle: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`angle: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("angle has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/angle"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Angle"));
+});
