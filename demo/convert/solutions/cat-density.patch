+import type { Category } from "../types.ts";
+
+export const density: Category = {
+  id: "density",
+  name: "Density",
+  base: "kg/m³",
+  units: [
+    { id: "kgm3", name: "Kilogram per cubic metre", symbol: "kg/m³", toBase: (v) => v, fromBase: (v) => v },
+    { id: "gcm3", name: "Gram per cubic centimetre", symbol: "g/cm³", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "kgl", name: "Kilogram per litre", symbol: "kg/L", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "lbft3", name: "Pound per cubic foot", symbol: "lb/ft³", toBase: (v) => v * 16.018463374, fromBase: (v) => v / 16.018463374 },
+    { id: "lbin3", name: "Pound per cubic inch", symbol: "lb/in³", toBase: (v) => v * 27679.9047102, fromBase: (v) => v / 27679.9047102 },
+    { id: "ozin3", name: "Ounce per cubic inch", symbol: "oz/in³", toBase: (v) => v * 1729.99404439, fromBase: (v) => v / 1729.99404439 },
+    { id: "lbgal", name: "Pound per US gallon", symbol: "lb/gal", toBase: (v) => v * 119.826427317, fromBase: (v) => v / 119.826427317 },
+  ],
+};
