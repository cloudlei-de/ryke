+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+import { shareButton, shareScript } from "../src/ui/share.ts";
+
+async function html(path: string): Promise<string> {
+  return (await worker.fetch(new Request(`http://localhost${path}`))).text();
+}
+
+test("converter pages have the copy-link button and its script", async () => {
+  const page = await html("/c/length");
+  assert.ok(page.includes(shareButton));
+  assert.ok(page.includes(shareScript));
+  assert.ok(page.includes("data-share"));
+  assert.ok(page.includes("navigator.clipboard"));
+});
+
+test("the home page has no copy-link button", async () => {
+  assert.ok(!(await html("/")).includes("data-share"));
+});
