@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=energy&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "kwh", to: "mj", v: 1, result: 3.6, display: "3.6" },
+  { from: "kcal", to: "kj", v: 1, result: 4.184, display: "4.184" },
+  { from: "btu", to: "j", v: 1, result: 1055.05585262, display: "1055.056" },
+];
+
+for (const c of cases) {
+  test(`energy: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`energy: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("energy has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/energy"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Energy"));
+});
