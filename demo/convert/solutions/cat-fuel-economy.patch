+import type { Category } from "../types.ts";
+
+// L/100km is the inverse of the other units, so its two functions are the same reciprocal.
+export const fuelEconomy: Category = {
+  id: "fuel-economy",
+  name: "Fuel economy",
+  base: "km/L",
+  units: [
+    { id: "kpl", name: "Kilometre per litre", symbol: "km/L", toBase: (v) => v, fromBase: (v) => v },
+    { id: "l100", name: "Litre per 100 km", symbol: "L/100km", toBase: (v) => 100 / v, fromBase: (v) => 100 / v },
+    { id: "mpg-us", name: "Mile per US gallon", symbol: "mpg", toBase: (v) => (v * 1.609344) / 3.785411784, fromBase: (v) => (v * 3.785411784) / 1.609344 },
+    { id: "mpg-uk", name: "Mile per imperial gallon", symbol: "mpg (UK)", toBase: (v) => (v * 1.609344) / 4.54609, fromBase: (v) => (v * 4.54609) / 1.609344 },
+  ],
+};
diff --git a/test/fuel-economy.test.ts b/test/fuel-economy.test.ts
