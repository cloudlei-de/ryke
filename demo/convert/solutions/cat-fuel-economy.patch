--- /dev/null
+++ b/test/fuel-economy.test.ts
@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=fuel-economy&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "l100", to: "kpl", v: 8, result: 12.5, display: "12.50" },
+  { from: "mpg-us", to: "kpl", v: 30, result: 12.7543112229, display: "12.75" },
+  { from: "mpg-us", to: "l100", v: 25, result: 9.40858333333, display: "9.41" },
+];
+
+for (const c of cases) {
+  test(`fuel-economy: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`fuel-economy: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("fuel-economy has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/fuel-economy"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Fuel economy"));
+});
