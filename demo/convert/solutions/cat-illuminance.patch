+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=illuminance&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "fc", to: "lx", v: 1, result: 10.7639104167, display: "10.76" },
+  { from: "ph", to: "lx", v: 1, result: 10000, display: "10000.00" },
+  { from: "lx", to: "fc", v: 1000, result: 92.9030400001, display: "92.90" },
+];
+
+for (const c of cases) {
+  test(`illuminance: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`illuminance: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("illuminance has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/illuminance"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Illuminance"));
+});
