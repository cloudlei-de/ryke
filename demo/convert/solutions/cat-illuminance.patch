+import type { Category } from "../types.ts";
+
+export const illuminance: Category = {
+  id: "illuminance",
+  name: "Illuminance",
+  base: "lx",
+  units: [
+    { id: "lx", name: "Lux", symbol: "lx", toBase: (v) => v, fromBase: (v) => v },
+    { id: "klx", name: "Kilolux", symbol: "klx", toBase: (v) => v * 1000, fromBase: (v) => v / 1000 },
+    { id: "fc", name: "Foot-candle", symbol: "fc", toBase: (v) => v * 10.7639104167, fromBase: (v) => v / 10.7639104167 },
+    { id: "ph", name: "Phot", symbol: "ph", toBase: (v) => v * 10000, fromBase: (v) => v / 10000 },
+    { id: "nx", name: "Nox", symbol: "nx", toBase: (v) => v * 0.001, fromBase: (v) => v / 0.001 },
+  ],
+};
