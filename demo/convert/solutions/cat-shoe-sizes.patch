+import type { Category } from "../types.ts";
+
+// Approximate: the usual Paris-point and barleycorn formulas applied to foot length; brands differ.
+export const shoeSizes: Category = {
+  id: "shoe-sizes",
+  name: "Shoe sizes",
+  base: "cm",
+  units: [
+    { id: "cm", name: "Foot length (cm)", symbol: "cm", toBase: (v) => v, fromBase: (v) => v },
+    { id: "eu", name: "EU size", symbol: "EU", toBase: (v) => v / 1.5 - 1.5, fromBase: (v) => (v + 1.5) * 1.5 },
+    { id: "uk", name: "UK size", symbol: "UK", toBase: (v) => ((v + 25) / 3) * 2.54, fromBase: (v) => (v / 2.54) * 3 - 25 },
+    { id: "us-m", name: "US men's size", symbol: "US M", toBase: (v) => ((v + 24) / 3) * 2.54, fromBase: (v) => (v / 2.54) * 3 - 24 },
+    { id: "us-w", name: "US women's size", symbol: "US W", toBase: (v) => ((v + 22.5) / 3) * 2.54, fromBase: (v) => (v / 2.54) * 3 - 22.5 },
+  ],
+};
diff --git a/test/shoe-sizes.test.ts b/test/shoe-sizes.test.ts
