@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import worker from "../src/index.ts";
+
+type Converted = { result: number; display: string };
+
+async function convert(from: string, to: string, v: number): Promise<Converted> {
+  const res = await worker.fetch(new Request(`http://localhost/api/convert?c=speed&from=${from}&to=${to}&v=${v}`));
+  assert.equal(res.status, 200);
+  return (await res.json()) as Converted;
+}
+
+// result is the converted number; display is formatValue(result), so it follows the shared number format.
+const cases = [
+  { from: "kmh", to: "mph", v: 100, result: 62.1371192237, display: "62.137" },
+  { from: "kn", to: "kmh", v: 1, result: 1.852, display: "1.852" },
+  { from: "mach", to: "kmh", v: 1, result: 1225.044, display: "1225.044" },
+];
+
+for (const c of cases) {
+  test(`speed: ${c.v} ${c.from} is ${c.result} ${c.to}`, async () => {
+    const got = await convert(c.from, c.to, c.v);
+    assert.ok(Math.abs(got.result - c.result) <= 1e-9 * Math.abs(c.result), `got ${got.result}`);
+  });
+  test(`speed: ${c.v} ${c.from} to ${c.to} displays as ${c.display}`, async () => {
+    assert.equal((await convert(c.from, c.to, c.v)).display, c.display);
+  });
+}
+
+test("speed has a converter page", async () => {
+  const res = await worker.fetch(new Request("http://localhost/c/speed"));
+  assert.equal(res.status, 200);
+  assert.ok((await res.text()).includes("Speed"));
+});
