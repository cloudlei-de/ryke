+import type { Category } from "../types.ts";
+
+export const speed: Category = {
+  id: "speed",
+  name: "Speed",
+  base: "m/s",
+  units: [
+    { id: "mps", name: "Metre per second", symbol: "m/s", toBase: (v) => v, fromBase: (v) => v },
+    { id: "kmh", name: "Kilometre per hour", symbol: "km/h", toBase: (v) => v / 3.6, fromBase: (v) => v * 3.6 },
+    { id: "mph", name: "Mile per hour", symbol: "mph", toBase: (v) => v * 0.44704, fromBase: (v) => v / 0.44704 },
+    { id: "kn", name: "Knot", symbol: "kn", toBase: (v) => (v * 1852) / 3600, fromBase: (v) => (v * 3600) / 1852 },
+    { id: "fps", name: "Foot per second", symbol: "ft/s", toBase: (v) => v * 0.3048, fromBase: (v) => v / 0.3048 },
+    { id: "mach", name: "Mach (sea level)", symbol: "Mach", toBase: (v) => v * 340.29, fromBase: (v) => v / 340.29 },
+  ],
+};
