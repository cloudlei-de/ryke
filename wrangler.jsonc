{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryke",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/preview/*", "/internal/*"]
  },
  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }] },
  "exports": { "Ledger": { "type": "durable-object", "storage": "sqlite" } },
  "workflows": [
    { "name": "ryke-land", "binding": "LAND", "class_name": "Land" },
    { "name": "ryke-ingest", "binding": "INGEST", "class_name": "Ingest" }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  // Local stand-ins (PLAN.md §2); dev/all.mjs and the tests override the URLs per port offset.
  "vars": {
    "RYKE_STORE": "local",
    "RYKE_RUNNER": "process",
    "RYKE_JEV": "recorded",
    "RYKE_NAMESPACE": "ryke",
    "RYKE_STORE_URL": "http://127.0.0.1:8788",
    "RYKE_RUNNER_URL": "http://127.0.0.1:8789",
    "RYKE_SCREENSHOTS": "0"
  },
  "env": {
    // `npx wrangler deploy --env production` (PLAN.md §13 M9). Needs Workers Paid with Artifacts,
    // Containers and Dynamic Workers; secrets: RYKE_TOKEN, RYKE_INTERNAL_SECRET, TYPESAFE_API_KEY,
    // ANTHROPIC_API_KEY (docs/deploy.md).
    "production": {
      "routes": [{ "pattern": "ryke.ai", "custom_domain": true }],
      "observability": { "enabled": true },
      "durable_objects": {
        "bindings": [
          { "name": "LEDGER", "class_name": "Ledger" },
          { "name": "RUNNER", "class_name": "Runner" }
        ]
      },
      "exports": {
        "Ledger": { "type": "durable-object", "storage": "sqlite" },
        "Runner": { "type": "durable-object", "storage": "sqlite", "container": "runner" }
      },
      "containers": [
        {
          "name": "runner",
          "class_name": "Runner",
          "scheduling_policy": "durable_object",
          "images": { "runner": { "dockerfile": "./containers/runner/Dockerfile", "build_context": "." } }
        }
      ],
      "workflows": [
        { "name": "ryke-land", "binding": "LAND", "class_name": "Land" },
        { "name": "ryke-ingest", "binding": "INGEST", "class_name": "Ingest" }
      ],
      "triggers": {
        "events": [
          {
            "type": "cf.artifacts.repo.pushed",
            "filter": { "namespace": "ryke" },
            "targets": [{ "type": "workflow", "workflow_name": "ryke-ingest" }]
          }
        ]
      },
      "worker_loaders": [{ "binding": "LOADER" }],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "ryke" }],
      "vars": {
        "RYKE_STORE": "artifacts",
        "RYKE_RUNNER": "container",
        "RYKE_JEV": "live",
        "RYKE_NAMESPACE": "ryke",
        "RYKE_STORE_URL": "",
        "RYKE_RUNNER_URL": "",
        // The runner image has no browser, so verify takes no screenshots in production yet.
        "RYKE_SCREENSHOTS": "0",
        // A third of the slots run seed, land and revert; the rest one verify or agent job each.
        "RYKE_RUNNER_SLOTS": "12"
      }
    }
  }
}
