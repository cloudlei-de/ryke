{
  "name": "ryke",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "CLOUDFLARE_ENV=production vite build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit",
    "test": "vitest run && npm run test:node",
    "test:node": "node --test --test-concurrency=4 \"test/node/*.test.mjs\"",
    "dev:all": "node dev/all.mjs",
    "e2e:land": "node harness/e2e/land.mjs",
    "swarm": "node harness/swarm.mjs",
    "ryke": "node harness/ryke.mjs",
    "deploy:dry": "CLOUDFLARE_ENV=production vite build && wrangler deploy --dry-run --outdir .wrangler/dry",
    "jev:record": "node harness/jev-record.mjs",
    "jev:calibrate": "node harness/jev-calibrate.mjs",
    "e2e:recall": "node harness/e2e/recall.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1",
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@cloudflare/worker-bundler": "0.2.6",
    "@modelcontextprotocol/server": "2.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "agents": "0.27.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
