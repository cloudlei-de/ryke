{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "./worker-configuration.d.ts",
      "vite/client",
      "@cloudflare/vitest-plugin/types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "*.ts"
  ]
}
